# BFF Service local configuration
# Each recipient service is mapped by its name (URL segment) -> base URL.
# Locally: copy to .env. On EB: use `eb setenv name=url ...` (NEVER commit a real .env).
#
# Task 10 spec scope: only Product Service and Cart Service are proxied through
# the BFF. Add other recipients (e.g. import) here only if your routing requires
# them — any unknown service name returns 502 by design.

PORT=4001

# Recipient services
product=https://pspuitbq9k.execute-api.eu-north-1.amazonaws.com/prod
cart=http://feodorius-cart-api-prod.eu-north-1.elasticbeanstalk.com

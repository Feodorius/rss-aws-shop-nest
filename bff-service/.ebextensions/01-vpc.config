# Explicit VPC / subnet configuration.
#
# Why this file exists:
# Our default VPC's subnets are not marked DefaultForAz=True, so when EB tries
# to launch a single-instance environment without explicit subnet hints, the
# AutoScaling group asks for "the default subnet in eu-north-1a" and the API
# returns "No default subnet for availability zone: 'eu-north-1a'", aborting
# the stack creation. Providing the VPC id and the EC2 subnets explicitly
# (across all three AZs) lets EB pick a working subnet for the single instance.
#
# Values mirror the working configuration of the cart-api EB environment.
option_settings:
  aws:ec2:vpc:
    VPCId: vpc-04e9bae39d8e73cf4
    Subnets: subnet-0ee78ef49079cf9de,subnet-03a4780299aa357d5,subnet-0c64a968dc7c8e806
    AssociatePublicIpAddress: 'true'
